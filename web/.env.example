# Biến môi trường frontend (web/)
# Sao chép thành `web/.env` cho môi trường local. Trên Vercel, khai báo các biến
# này trong Project Settings -> Environment Variables.
#
# Client id của Google/Facebook là thông tin công khai (không phải secret),
# nhưng vẫn không commit file `.env`.

# Google Identity Services client id (dùng cho nút "Đăng nhập với Google").
GOOGLE_CLIENT_ID=

# Facebook app id và Graph API version (dùng cho "Đăng nhập với Facebook").
FACEBOOK_APP_ID=
FACEBOOK_GRAPH_VERSION=v21.0
