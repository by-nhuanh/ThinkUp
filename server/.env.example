# ==============================================================================
# THINKUP BACKEND ENVIRONMENT VARIABLES (.env.example)
# Dùng để cấu hình biến môi trường trên Railway (Production) hoặc máy cục bộ
# ==============================================================================

# 1. CẤU HÌNH SERVER & ANGULAR CLIENT (DEMO PRODUCTION VERCEL)
NODE_ENV=production
PORT=5000

# URL của Frontend Client và Admin trên Vercel:
CLIENT_URL=https://think-up-edu.vercel.app
ADMIN_URL=https://think-up-admin.vercel.app

# URL của Backend sau khi deploy lên Vercel (ví dụ: https://thinkup-server.vercel.app):
API_URL=https://thinkup-server.vercel.app

# Danh sách domain được phép gọi API (CORS):
CORS_ORIGIN=https://think-up-edu.vercel.app,https://thinkup-edu.vercel.app,https://think-up-admin.vercel.app,https://thinkup-admin.vercel.app,http://localhost:4200,http://localhost:4201

# 2. XÁC THỰC BẢO MẬT (JWT)
# Khóa bí mật ký token JWT (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your_super_secret_jwt_key_railway_production_2026
JWT_EXPIRES_IN=24h

# 3. CƠ SỞ DỮ LIỆU MONGODB
# Chuỗi kết nối MongoDB Atlas (sử dụng database Thinkup)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Thinkup?retryWrites=true&w=majority
MONGODB_DB_NAME=Thinkup

# 4. GOOGLE OAUTH 2.0 (Cấu hình trên Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Authorized redirect URI trên Google Console:
GOOGLE_CALLBACK_URL=https://thinkup-backend.up.railway.app/api/auth/google/callback

# 5. FACEBOOK OAUTH (Cấu hình trên Meta for Developers)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Valid OAuth Redirect URI trên Facebook Developer Dashboard:
FACEBOOK_GRAPH_VERSION=
# Facebook JavaScript SDK uses FACEBOOK_APP_ID and FACEBOOK_GRAPH_VERSION publicly.
# FACEBOOK_APP_SECRET stays on the server. Enable the web domain in the Meta app.

# 6. GỬI EMAIL XÁC THỰC & MÃ OTP
# Cách 1 (Khuyên dùng): Google OAuth2 tách riêng
GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_oauth2_refresh_token
SMTP_FROM="ThinkUp" <your_email@gmail.com>

# Cách 2 (Dự phòng): SMTP thông thường (Gmail App Password, Brevo, Resend...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
# ==============================================================================
# 7. CLOUDINARY (LƯU TRỮ HÌNH ẢNH / MEDIA)
# Lấy các thông số này tại Cloudinary Dashboard: https://console.cloudinary.com/
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# (Tùy chọn) Thư mục mặc định trên Cloudinary để phân loại ảnh của dự án
CLOUDINARY_FOLDER=
# LIVEKIT
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# VNPAY SANDBOX (Thanh toán nội địa)
VNP_TMN_CODE=0DV5TG3O        
VNP_HASH_SECRET=
VNP_URL=
VNP_RETURN_URL=
VNPAY_API_URL=
# 3. SEPAY / CASSO 
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NO=
BANK_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_KEY=                     

# 4. STRIPE SANDBOX 

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Provider flows use the URLs/keys above; these selected methods simulate on backend only.
PAYMENT_MODE=live
PAYMENT_SIMULATED_METHODS=sepay,momo,zalopay,paypal,apple-pay,swift
# Send result emails for new simulated payments, respecting notification preferences.
PAYMENT_SIMULATION_EMAIL=true


GMAIL_USER= thinkup.edu.vn@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
