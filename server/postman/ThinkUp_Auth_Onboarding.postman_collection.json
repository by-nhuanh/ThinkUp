{
  "info": {
    "_postman_id": "2d5a9aeb-9e37-48b0-b8f5-0a5e424d8702",
    "name": "ThinkUp - Hệ Thống Auth & Onboarding API",
    "description": "Bộ sưu tập kiểm thử API toàn diện cho hệ sinh thái ThinkUp (Xác thực học viên, Quên mật khẩu, và Khảo sát đầu vào Onboarding 3 bước).\n\nĐồng bộ 100% với tài liệu đặc tả `auth_onboarding.md` và CSDL thực tế MongoDB Atlas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Kiểm Tra Trạng Thái Hệ Thống (Health Check)",
      "item": [
        {
          "name": "0.1 Kiểm tra máy chủ (Health Check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Kiểm tra tình trạng hoạt động và thời gian uptime của máy chủ Backend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Máy chủ phản hồi 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status trả về 'ok'\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Module Đăng Ký Học Viên (Sign Up)",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản mới (Email & Mật khẩu)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{testFullName}}\",\n  \"phone\": \"{{testPhone}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"termsAccepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản học viên mới với 5 trường thông tin, kiểm tra tự động sinh mã học viên HVxxxxxx và gửi email xác thực kích hoạt 12 giờ."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng ký thành công trả về 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Thông báo yêu cầu kích hoạt qua email\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.email).to.eql(pm.environment.get(\"testEmail\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Xác thực kích hoạt tài khoản qua Link Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify?token={{verificationToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{verificationToken}}",
                  "description": "JWT Token xác thực nhận được trong liên kết gửi về email (hiệu lực 12h)"
                }
              ]
            },
            "description": "Kích hoạt tài khoản khi người dùng nhấp vào link trong email xác thực."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Phản hồi trạng thái kích hoạt\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Gửi lại liên kết xác thực (Resend Verification)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-verification"
              ]
            },
            "description": "Cấp lại link kích hoạt mới 12 giờ khi người dùng chưa nhận được email hoặc link cũ hết hạn (cooldown chống spam 60s)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Phản hồi gửi lại email hợp lệ\", function () {",
                  "    pm.expect([200, 400, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Đăng ký nhanh Google OAuth (Just-In-Time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student_google@thinkup.edu.vn\",\n  \"name\": \"Nguyễn Văn Google\",\n  \"avatar\": \"https://lh3.googleusercontent.com/a/default-user\",\n  \"providerId\": \"google_sub_123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "signup"
              ]
            },
            "description": "Đăng ký nhanh qua Google OAuth, tự động cấp role: student, email_verified: true, mã học viên HVxxxxxx và onboarding_completed: false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng ký Google thành công hoặc báo tài khoản đã tồn tại\", function () {",
                  "    pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set(\"accessToken\", json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Đăng ký nhanh Facebook OAuth (Just-In-Time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student_fb@thinkup.edu.vn\",\n  \"name\": \"Nguyễn Văn Facebook\",\n  \"avatar\": \"https://graph.facebook.com/12345/picture\",\n  \"providerId\": \"fb_id_987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/facebook/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "facebook",
                "signup"
              ]
            },
            "description": "Đăng ký nhanh qua Facebook OAuth (bắt buộc học viên cho phép truy cập email Facebook)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng ký Facebook thành công hoặc báo tài khoản đã tồn tại\", function () {",
                  "    pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Module Đăng Nhập & Phiên Làm Việc (Sign In)",
      "item": [
        {
          "name": "2.1 Đăng nhập Email & Mật khẩu (Sign In)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"rememberMe\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập hệ thống bằng email và mật khẩu. Tự động lưu `accessToken` và `studentId` vào Environment để dùng cho các request tiếp theo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng nhập thành công trả về 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Phản hồi có JWT token hợp lệ\", function () {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "});",
                  "if (json.token) {",
                  "    pm.environment.set(\"accessToken\", json.token);",
                  "    console.log(\"[Postman] Đã tự động lưu accessToken:\", json.token);",
                  "}",
                  "if (json.user && json.user.studentId) {",
                  "    pm.environment.set(\"studentId\", json.user.studentId);",
                  "    console.log(\"[Postman] Đã lưu studentId:\", json.user.studentId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Đăng nhập Google OAuth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student_google@thinkup.edu.vn\",\n  \"providerId\": \"google_sub_123456789\",\n  \"name\": \"Nguyễn Văn Google\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "login"
              ]
            },
            "description": "Đăng nhập bằng tài khoản Google. Hỗ trợ tự động liên kết tài khoản nếu email đã tồn tại."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set(\"accessToken\", json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Đăng nhập Facebook OAuth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student_fb@thinkup.edu.vn\",\n  \"providerId\": \"fb_id_987654321\",\n  \"name\": \"Nguyễn Văn Facebook\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/facebook/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "facebook",
                "login"
              ]
            },
            "description": "Đăng nhập bằng tài khoản Facebook."
          }
        },
        {
          "name": "2.4 Lấy thông tin tài khoản hiện tại (Current User)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Lấy hồ sơ cá nhân của học viên đang đăng nhập. Trả về thông tin: id, fullName, email, phone, role, studentId, onboarding_completed..."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lấy thông tin thành công 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Hồ sơ người dùng chứa trường studentId\", function () {",
                  "    pm.expect(json.user).to.have.property(\"studentId\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Kiểm tra phiên làm việc Header (Session Check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": "Frontend gọi khi tải trang để hiển thị Avatar/Họ tên trên Header hoặc chuyển hướng."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Kiểm tra session 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Xác nhận trạng thái đăng nhập\", function () {",
                  "    pm.expect(json.isAuthenticated).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Đăng xuất (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Đăng xuất tài khoản học viên và kết thúc phiên làm việc."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng xuất thành công 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Module Quên & Đặt Lại Mật Khẩu (Forgot Password)",
      "item": [
        {
          "name": "3.1 Yêu cầu gửi mã OTP (Forgot Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Yêu cầu gửi mã OTP gồm 6 chữ số về email của học viên (hiệu lực 5 phút, cooldown 60s)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Yêu cầu gửi OTP thành công 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Xác thực OTP 6 số (Verify OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-forgot-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-forgot-otp"
              ]
            },
            "description": "Xác thực mã OTP 6 số nhận được qua email. Thành công sẽ tự động lưu `resetToken` vào Environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.resetToken) {",
                  "    pm.environment.set(\"resetToken\", json.resetToken);",
                  "    console.log(\"[Postman] Đã tự động lưu resetToken:\", json.resetToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Gửi lại mã OTP (Resend Forgot OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-forgot-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-forgot-otp"
              ]
            },
            "description": "Gửi lại OTP mới khi học viên không nhận được mã (cooldown 60s)."
          }
        },
        {
          "name": "3.4 Đặt lại mật khẩu mới (Reset Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword@2026\",\n  \"confirmPassword\": \"NewPassword@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Cập nhật mật khẩu mới bằng `resetToken` dùng 1 lần, hủy mọi phiên đăng nhập cũ."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Phản hồi đặt lại mật khẩu\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Module Khảo Sát Đầu Vào Học Viên (Onboarding Survey)",
      "item": [
        {
          "name": "4.1 Bỏ qua khảo sát (Skip Onboarding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/onboarding/skip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "onboarding",
                "skip"
              ]
            },
            "description": "Khi học viên bấm 'Bỏ qua': Hệ thống không lưu sở thích vào DB, đánh dấu onboarding_completed: true và trả về toàn bộ khóa học theo thứ tự mặc định trong CSDL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
